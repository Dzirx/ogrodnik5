# Skopiuj do .env i uzupełnij. Zmienna środowiska wygrywa z .env.
OPENAI_API_KEY=
AUTH_USERNAME=
AUTH_PASSWORD=

# Modele OpenAI
ANSWER_MODEL=
ANALYSIS_MODEL=
# Odczyt tabel z obrazu strony; puste = ANSWER_MODEL, potem gpt-4o
TABELE_MODEL=
# Przewodnik ksiazka.md
PRZEWODNIK_MODEL=gpt-5.4-mini
# Ile stron idzie do jednego wywołania przewodnika
PRZEWODNIK_STRON_NA_KAWALEK=300

# Limity narzędzi agenta
SZUKAJ_LIMIT_TRAFIEN=20
CZYTAJ_LIMIT_STRON=8

# Agent
ORKIESTRATOR_MODEL=gpt-5.4

# Wariant agenta: strony (szukacz wskazuje strony, kod je wkleja, pisarz pisze) | dwa (szukacz zbiera notatki, pisarz układa tekst) | jeden (jeden agent szuka, czyta i pisze)
AGENT=strony
JEDEN_LIMIT_RUND=20

# Warianty strony i dwa
SZUKACZ_MODEL=gpt-5.4-mini
PISARZ_MODEL=gpt-5.4
SZUKACZ_LIMIT_RUND=20
STRONY_LIMIT=12

# Planista (wariant strony): tak | nie
PLANISTA=tak
PLANISTA_MODEL=gpt-5.4-mini
