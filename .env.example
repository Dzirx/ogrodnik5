# Skopiuj do .env i uzupełnij. Zmienna środowiska wygrywa z .env.
OPENAI_API_KEY=
AUTH_USERNAME=
AUTH_PASSWORD=

# Modele OpenAI
ANSWER_MODEL=
ANALYSIS_MODEL=
# Odczyt tabel z obrazu strony; puste = ANSWER_MODEL, potem gpt-4o
TABELE_MODEL=
# Przewodnik ksiazka.md
PRZEWODNIK_MODEL=gpt-5.4-mini
# Ile stron idzie do jednego wywołania przewodnika
PRZEWODNIK_STRON_NA_KAWALEK=300
